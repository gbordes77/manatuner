+    let networkSignal: AbortSignal | null | undefined
+    vi.stubGlobal(
+      'fetch',
+      vi.fn((_url, init) => {
+        networkSignal = init.signal
+        return Promise.resolve({ ok: true, status: 200, json: () => new Promise(() => {}) })
+      })
