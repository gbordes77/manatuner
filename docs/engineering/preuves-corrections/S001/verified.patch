+import { beforeEach, afterEach, describe, expect, it, vi } from 'vitest'
+import { PrivacyStorage } from '../privacy'
+const key = 'manatuner_analyses'
+const record = (id = 'good', analysis: unknown = { averageCMC: 2, cards: [] }) => ({
+  id,
+  deckName: id,
